---
import GamesDetailDocument from "~/components/games-detail-document.astro";
import type { GamesDetailPage } from "~/data/games";
import { getLocalizedGamesDetailStaticPaths } from "~/data/games";

export function getStaticPaths() {
  return getLocalizedGamesDetailStaticPaths();
}

const { page } = Astro.props as { page: GamesDetailPage };
---

<GamesDetailDocument page={page} />
