---
import CatalogShell from "~/components/catalog/catalog-shell.astro";
import {
  GAMEHUB_APP_STORE_URL,
  getOwnGame,
  ownGames,
} from "~/lib/catalog";

export function getStaticPaths() {
  return ownGames.map((game) => ({
    params: { slug: game.slug },
  }));
}

const { slug } = Astro.params;
const game = getOwnGame(slug!);
if (!game) {
  throw new Error(`Unknown game slug: ${slug}`);
}

const related = ownGames.filter((g) => g.slug !== game.slug).slice(0, 6);
const title = `${game.nameEn} for Apple Watch | Games for Watch`;
const description =
  game.description ||
  `Play ${game.nameEn} on Apple Watch with GameHub — offline mini games for your wrist.`;
---

<CatalogShell
  title={title}
  description={description}
  path={`/games/${game.slug}/`}
  ogImage={game.preview || undefined}
>
  <article class="mx-auto max-w-7xl px-6 py-12 lg:px-8">
    <nav class="text-black/45 text-sm">
      <a class="hover:text-black" href="/">Home</a>
      <span class="mx-2">/</span>
      <a class="hover:text-black" href="/games/">Our Games</a>
      <span class="mx-2">/</span>
      <span class="text-black/70">{game.nameEn}</span>
    </nav>

    <div class="mt-8 grid items-start gap-10 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="border-black/8 overflow-hidden rounded-3xl border bg-white shadow-[0_12px_40px_rgba(15,23,42,0.06)]">
        {
          game.preview ? (
            <img src={game.preview} alt={`${game.nameEn} preview`} class="w-full object-cover" />
          ) : (
            <div class="text-black/35 flex aspect-square items-center justify-center">No preview</div>
          )
        }
      </div>

      <div>
        <div class="flex flex-wrap gap-2">
          {
            game.isNew ? (
              <span class="rounded-full bg-black/[0.06] px-2.5 py-1 text-xs font-medium text-black/70">New</span>
            ) : null
          }
          {
            game.isVip ? (
              <span class="rounded-full bg-black/[0.06] px-2.5 py-1 text-xs font-medium text-black/70">VIP</span>
            ) : null
          }
          {
            game.isFeatured ? (
              <span class="rounded-full bg-black px-2.5 py-1 text-xs font-medium text-white">Featured</span>
            ) : null
          }
        </div>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">{game.nameEn}</h1>
        <p class="text-black/50 mt-2 text-lg">{game.name}</p>
        <p class="text-black/70 mt-5 text-base leading-relaxed">{game.description}</p>

        <a
          href={GAMEHUB_APP_STORE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex rounded-full border border-black/10 bg-white px-6 py-3 text-sm font-semibold text-black transition hover:border-black/20 hover:bg-white/80"
        >
          Play in GameHub on Apple Watch
        </a>
        <p class="text-black/45 mt-3 text-sm">
          Included in GameHub — Mini Games for Watch. Offline play, Watch-first controls.
        </p>
      </div>
    </div>

    {
      related.length ? (
        <section class="mt-16">
          <h2 class="text-2xl font-semibold tracking-tight">More GameHub games</h2>
          <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((item) => (
              <li>
                <a
                  href={`/games/${item.slug}/`}
                  class="border-black/8 flex items-center gap-3 rounded-2xl border bg-white p-3 shadow-sm transition hover:border-black/15 hover:shadow-md"
                >
                  {item.preview ? (
                    <img src={item.preview} alt="" class="h-14 w-14 rounded-xl object-cover" loading="lazy" />
                  ) : null}
                  <div>
                    <div class="font-medium">{item.nameEn}</div>
                    <div class="text-black/45 text-sm">{item.name}</div>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ) : null
    }
  </article>
</CatalogShell>
