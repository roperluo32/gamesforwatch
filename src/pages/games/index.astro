---
import CatalogShell from "~/components/catalog/catalog-shell.astro";
import { GAMEHUB_APP_STORE_URL, ownGames, ownGamesMeta } from "~/lib/catalog";
---

<CatalogShell
  title="Our Apple Watch Games | Games for Watch"
  description="Play 30+ classic mini games on Apple Watch with GameHub — offline, no ads, Watch-first."
  path="/games/"
>
  <section class="mx-auto max-w-6xl px-4 py-12">
    <div class="max-w-2xl">
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-pink-300">GameHub collection</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">Our Watch games</h1>
      <p class="mt-4 text-lg text-white/70">
        {ownGames.length} mini games built for Apple Watch. Play offline in GameHub — Mini Games for Watch.
      </p>
      <a
        href={GAMEHUB_APP_STORE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex rounded-full bg-pink-500 px-5 py-2.5 text-sm font-semibold text-white hover:bg-pink-400"
      >
        Download on the App Store
      </a>
    </div>

    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        ownGames.map((game) => (
          <li>
            <a
              href={`/games/${game.slug}/`}
              class="group block overflow-hidden rounded-2xl border border-white/10 bg-white/5 transition hover:border-pink-400/40 hover:bg-white/[0.07]"
            >
              <div class="aspect-[4/3] overflow-hidden bg-[#12182a]">
                {game.preview ? (
                  <img
                    src={game.preview}
                    alt={game.nameEn}
                    class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                ) : null}
              </div>
              <div class="p-4">
                <div class="flex flex-wrap items-center gap-2">
                  <h2 class="text-lg font-semibold text-white">{game.nameEn}</h2>
                  {game.isNew ? (
                    <span class="rounded-full bg-emerald-500/20 px-2 py-0.5 text-xs text-emerald-300">New</span>
                  ) : null}
                  {game.isVip ? (
                    <span class="rounded-full bg-amber-500/20 px-2 py-0.5 text-xs text-amber-200">VIP</span>
                  ) : null}
                </div>
                <p class="mt-1 text-sm text-white/50">{game.name}</p>
                <p class="mt-2 line-clamp-2 text-sm text-white/65">{game.description}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-8 text-xs text-white/40">Synced from GameHub · {ownGamesMeta.exportedAt}</p>
  </section>
</CatalogShell>
