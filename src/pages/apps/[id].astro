---
import CatalogShell from "~/components/catalog/catalog-shell.astro";
import {
  GAMEHUB_APP_STORE_URL,
  GAMEHUB_TRACK_ID,
  appLocale,
  formatBytes,
  formatDate,
  getCatalogIndex,
  loadCatalogApp,
  ownGames,
} from "~/lib/catalog";

export function getStaticPaths() {
  return getCatalogIndex().map((app) => ({
    params: { id: `${app.trackId}-${app.slug}` },
    props: { trackId: app.trackId },
  }));
}

interface Props {
  trackId: string;
}

const { trackId } = Astro.props as Props;
const app = loadCatalogApp(trackId);
if (!app) throw new Error(`Missing catalog app ${trackId}`);

const loc = appLocale(app, "en");
const title = `${loc?.trackName || app.slug} for Apple Watch`;
const description =
  (loc?.description || "").slice(0, 160) || `Apple Watch game: ${loc?.trackName}`;
const watchShots = app.watchScreenshots || [];
const phoneShots = app.phoneScreenshots || [];
const shots = watchShots.length ? watchShots : phoneShots;
const history = [...(app.versionHistory || [])].reverse();
const isOwn = app.trackId === GAMEHUB_TRACK_ID || app.isOwnApp;
---

<CatalogShell
  title={`${title} | Games for Watch`}
  description={description}
  path={app.path}
  ogImage={app.artworkUrl512}
>
  <article class="mx-auto max-w-7xl px-6 py-12 lg:px-8">
    <nav class="text-black/45 text-sm">
      <a class="hover:text-black" href="/apps/">Watch Apps</a>
      <span class="mx-2">/</span>
      <span class="text-black/70">{loc?.trackName}</span>
    </nav>

    <header class="mt-8 flex flex-col gap-6 sm:flex-row sm:items-start">
      <img
        src={app.artworkUrl512}
        alt=""
        class="border-black/8 h-28 w-28 shrink-0 rounded-[28px] border bg-white shadow-[0_12px_32px_rgba(15,23,42,0.1)]"
        width="112"
        height="112"
      />
      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-2">
          {
            app.hasWatch ? (
              <span class="rounded-full bg-black/[0.06] px-2.5 py-1 text-xs font-medium text-black/70">
                Apple Watch
              </span>
            ) : null
          }
          {
            isOwn ? (
              <span class="rounded-full bg-black px-2.5 py-1 text-xs font-medium text-white">Our app</span>
            ) : null
          }
        </div>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{loc?.trackName}</h1>
        {loc?.subtitle ? <p class="text-black/55 mt-2 text-base">{loc.subtitle}</p> : null}
        <p class="mt-2 text-base text-black/70">
          {
            app.artistViewUrl ? (
              <a href={app.artistViewUrl} target="_blank" rel="noopener noreferrer" class="hover:underline">
                {loc?.sellerName || app.artistName}
              </a>
            ) : (
              loc?.sellerName || app.artistName
            )
          }
        </p>
        <div class="text-black/60 mt-4 flex flex-wrap items-center gap-4 text-sm">
          <span>
            ★ {(app.averageUserRating || 0).toFixed(1)}
            <span class="text-black/35">({app.userRatingCount || 0})</span>
          </span>
          <span>{loc?.formattedPrice || (app.price === 0 ? "Free" : "")}</span>
          <span>v{app.version}</span>
        </div>
        <a
          href={loc?.trackViewUrl || `https://apps.apple.com/app/id${app.trackId}`}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex rounded-full border border-black/10 bg-white px-6 py-2.5 text-sm font-semibold text-black transition hover:border-black/20 hover:bg-white/80"
        >
          Get on App Store
        </a>
      </div>
    </header>

    {
      shots.length ? (
        <section class="mt-12">
          <h2 class="text-black/40 text-sm font-semibold uppercase tracking-[0.18em]">
            {watchShots.length ? "Watch screenshots" : "Screenshots"}
          </h2>
          <div class="mt-4 flex gap-4 overflow-x-auto pb-2">
            {shots.map((url) => (
              <img
                src={url}
                alt=""
                class:list={[
                  "border-black/8 shrink-0 rounded-2xl border bg-white object-cover shadow-sm",
                  watchShots.length ? "h-64 w-auto" : "h-80 w-auto",
                ]}
                loading="lazy"
              />
            ))}
          </div>
          {watchShots.length && phoneShots.length ? (
            <div class="mt-8">
              <h3 class="text-black/40 text-sm font-semibold uppercase tracking-[0.18em]">
                iPhone screenshots
              </h3>
              <div class="mt-4 flex gap-4 overflow-x-auto pb-2">
                {phoneShots.slice(0, 8).map((url) => (
                  <img
                    src={url}
                    alt=""
                    class="border-black/8 h-72 w-auto shrink-0 rounded-2xl border bg-white object-cover shadow-sm"
                    loading="lazy"
                  />
                ))}
              </div>
            </div>
          ) : null}
        </section>
      ) : (
        <section class="border-black/10 text-black/50 mt-12 rounded-2xl border border-dashed bg-white/60 p-6 text-sm">
          Store screenshots are not available for this app yet.
        </section>
      )
    }

    <section class="mt-12 max-w-3xl">
      <h2 class="text-2xl font-semibold tracking-tight">Description</h2>
      <div class="text-black/70 mt-4 whitespace-pre-wrap text-[15px] leading-7">{loc?.description}</div>
    </section>

    {
      loc?.releaseNotes ? (
        <section class="mt-12 max-w-3xl">
          <h2 class="text-2xl font-semibold tracking-tight">What's New</h2>
          <p class="text-black/45 mt-2 text-sm">
            Version {app.version} · {formatDate(app.currentVersionReleaseDate)}
          </p>
          <div class="text-black/70 mt-4 whitespace-pre-wrap text-[15px] leading-7">{loc.releaseNotes}</div>
        </section>
      ) : null
    }

    {
      history.length ? (
        <section class="mt-12 max-w-3xl">
          <h2 class="text-2xl font-semibold tracking-tight">Version History</h2>
          <ol class="border-black/10 mt-6 space-y-6 border-l pl-6">
            {history.map((item) => (
              <li class="relative">
                <span class="absolute -left-[1.55rem] top-1.5 h-2.5 w-2.5 rounded-full bg-black" />
                <div class="flex flex-wrap items-baseline gap-3">
                  <span class="font-semibold">v{item.version}</span>
                  <span class="text-black/45 text-sm">{formatDate(item.seenAt)}</span>
                </div>
                {item.releaseNotes ? (
                  <p class="text-black/65 mt-2 whitespace-pre-wrap text-sm leading-6">{item.releaseNotes}</p>
                ) : (
                  <p class="text-black/40 mt-2 text-sm">No release notes captured.</p>
                )}
              </li>
            ))}
          </ol>
        </section>
      ) : null
    }

    <section class="mt-12 max-w-3xl">
      <h2 class="text-2xl font-semibold tracking-tight">Information</h2>
      <dl class="border-black/10 mt-4 divide-y divide-black/10 border-y text-sm">
        <div class="flex justify-between gap-4 py-3">
          <dt class="text-black/45">Seller</dt>
          <dd class="text-right text-black/85">{loc?.sellerName || app.artistName}</dd>
        </div>
        <div class="flex justify-between gap-4 py-3">
          <dt class="text-black/45">Size</dt>
          <dd class="text-right text-black/85">{formatBytes(app.fileSizeBytes)}</dd>
        </div>
        <div class="flex justify-between gap-4 py-3">
          <dt class="text-black/45">Category</dt>
          <dd class="text-right text-black/85">{(loc?.genres || []).join(", ") || "—"}</dd>
        </div>
        <div class="flex justify-between gap-4 py-3">
          <dt class="text-black/45">Compatibility</dt>
          <dd class="text-right text-black/85">
            {app.hasWatch ? "Apple Watch" : "iOS"}
            {app.minimumOsVersion ? ` · iOS ${app.minimumOsVersion}+` : ""}
          </dd>
        </div>
        <div class="flex justify-between gap-4 py-3">
          <dt class="text-black/45">Languages</dt>
          <dd class="text-right text-black/85">
            {(loc?.languageCodesISO2A || []).slice(0, 12).join(", ") || "—"}
          </dd>
        </div>
        <div class="flex justify-between gap-4 py-3">
          <dt class="text-black/45">Age Rating</dt>
          <dd class="text-right text-black/85">{app.contentAdvisoryRating || "—"}</dd>
        </div>
        <div class="flex justify-between gap-4 py-3">
          <dt class="text-black/45">Game Center</dt>
          <dd class="text-right text-black/85">{app.isGameCenterEnabled ? "Yes" : "No"}</dd>
        </div>
        <div class="flex justify-between gap-4 py-3">
          <dt class="text-black/45">Price</dt>
          <dd class="text-right text-black/85">{loc?.formattedPrice || "—"}</dd>
        </div>
        <div class="flex justify-between gap-4 py-3">
          <dt class="text-black/45">Updated</dt>
          <dd class="text-right text-black/85">{formatDate(app.currentVersionReleaseDate)}</dd>
        </div>
      </dl>
    </section>

    {
      isOwn ? (
        <section class="border-black/8 mt-12 rounded-2xl border bg-white p-6 shadow-[0_8px_24px_rgba(15,23,42,0.04)]">
          <h2 class="text-xl font-semibold tracking-tight">Play these games inside GameHub</h2>
          <p class="text-black/60 mt-2 text-sm">
            GameHub includes {ownGames.length}+ Watch-first mini games. Browse the full collection on this site.
          </p>
          <a href="/games/" class="mt-4 inline-flex text-sm font-semibold text-black hover:underline">
            Browse our games →
          </a>
        </section>
      ) : (
        <section class="border-black/8 mt-12 rounded-2xl border bg-white p-6 shadow-[0_8px_24px_rgba(15,23,42,0.04)]">
          <h2 class="text-xl font-semibold tracking-tight">Looking for more Watch games?</h2>
          <p class="text-black/60 mt-2 text-sm">
            Try GameHub — Mini Games for Watch: 30+ classics, offline, no ads, built for your wrist.
          </p>
          <a
            href={GAMEHUB_APP_STORE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex rounded-full border border-black/10 bg-white px-5 py-2 text-sm font-semibold text-black transition hover:border-black/20"
          >
            Get GameHub
          </a>
        </section>
      )
    }
  </article>
</CatalogShell>
