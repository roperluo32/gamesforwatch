---
import { Icon } from "astro-icon/components";
import PostHogAnalytics from "~/components/posthog-analytics.astro";
import { appStoreUrl } from "~/data/landing";
import type { ArticleEntry, ArticleListPage } from "~/data/articles";
import { getArticlePath } from "~/data/articles";
import "~/styles/index.css";

interface Props {
  page: ArticleListPage;
}

const { page } = Astro.props as Props;
const { generator, site } = Astro;
const pageUrl = new URL(page.path, site);
const image = new URL("social.jpg", site);
const posthogKey =
  import.meta.env.PUBLIC_POSTHOG_KEY ??
  "phc_hts9RHJKhHUgcr0iZTWbPjbVI1dkZq4TI9DvRY9wa6V";
const posthogHost =
  import.meta.env.PUBLIC_POSTHOG_HOST ?? "https://us.i.posthog.com";

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat(page.langAttr, {
    year: "numeric",
    month: "short",
    day: "numeric",
  }).format(date);

const getArticleUrl = (entry: ArticleEntry) =>
  getArticlePath(entry.data.locale, entry.data.articleSlug);

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: page.title,
  description: page.description,
  url: pageUrl.href,
  inLanguage: page.langAttr,
};
---

<!doctype html>
<html lang={page.langAttr} class="h-full motion-safe:scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/brand/app-logo.png" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/app-logo.png" />
    <meta name="generator" content={generator} />

    <title>{page.title}</title>
    <meta name="description" content={page.description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={pageUrl.href} />
    {
      page.alternatePaths.map((item) => (
        <link
          rel="alternate"
          hreflang={item.hreflang}
          href={new URL(item.path, site).href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(page.defaultPath, site).href}
    />
    <meta name="apple-itunes-app" content="app-id=6752821820" />

    <meta property="og:title" content={page.title} />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={page.description} />
    <meta property="og:image" content={image.href} />
    <meta property="og:url" content={pageUrl.href} />
    <meta property="og:site_name" content="Games for Watch" />
    <meta property="og:locale" content={page.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={page.title} />
    <meta name="twitter:description" content={page.description} />
    <meta name="twitter:image" content={image.href} />
    <meta name="twitter:url" content={pageUrl.href} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(collectionSchema)}
    />
  </head>
  <body
    class="h-full overflow-x-hidden bg-[#f5f5f7] text-[#1d1d1f] text-base"
    data-locale={page.locale}
    data-posthog-key={posthogKey}
    data-posthog-host={posthogHost}
  >
    <div class="min-h-screen bg-[#f5f5f7]">
      <header
        class="border-black/6 sticky top-0 z-50 border-b bg-[rgba(245,245,247,0.76)] backdrop-blur-2xl"
      >
        <div
          class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-6 py-4 lg:px-8"
        >
          <a href={page.homePath} class="flex min-w-0 items-center gap-3">
            <img
              src="/brand/app-logo.png"
              alt="Games for Watch logo"
              class="border-black/8 size-10 rounded-[0.9rem] border bg-white object-cover shadow-[0_8px_24px_rgba(15,23,42,0.08)]"
            />
            <span class="hidden min-w-0 sm:block">
              <span class="block truncate font-semibold text-[0.98rem]"
                >Games for Watch</span
              >
              <span class="text-black/48 block truncate text-xs"
                >{page.ui.blogLabel}</span
              >
            </span>
          </a>

          <nav class="text-black/56 hidden items-center gap-7 text-sm lg:flex">
            <a href={page.homePath} class="transition hover:text-black"
              >{page.ui.homeLabel}</a
            >
            <a href={page.path} class="font-semibold text-black"
              >{page.ui.blogLabel}</a
            >
          </nav>

          <div class="flex items-center gap-2.5">
            <details class="language-switcher">
              <summary class="language-switcher__summary">
                <span>{page.ui.languageLabel}</span>
                <span class="language-switcher__current">
                  {page.languages.find((item) => item.active)?.title ?? "EN"}
                </span>
                <Icon name="mdi:chevron-down" class="text-black/52 size-4" />
              </summary>
              <div class="language-switcher__menu">
                {
                  page.languages.map((item) => (
                    <a
                      href={item.url}
                      class:list={[
                        "language-switcher__item",
                        item.active && "language-switcher__item--active",
                      ]}
                    >
                      <span>{item.title}</span>
                      {item.active && (
                        <Icon name="mdi:check" class="size-4 shrink-0" />
                      )}
                    </a>
                  ))
                }
              </div>
            </details>
            <a
              href={appStoreUrl}
              target="_blank"
              rel="noreferrer"
              class="hover:bg-white/82 inline-flex rounded-full border border-black/10 bg-white px-4 py-2.5 font-semibold text-black transition text-sm hover:border-black/20"
            >
              {page.ui.storeLabel}
            </a>
          </div>
        </div>
      </header>

      <main>
        <section>
          <div class="mx-auto max-w-5xl px-6 py-12 lg:px-8 lg:py-16">
            {
              page.articles.length > 0 ? (
                <div class="space-y-4">
                  {page.articles.map((entry) => (
                    <a
                      href={getArticleUrl(entry)}
                      class="article-row group"
                    >
                      <div class="article-row__content">
                        <div class="article-row__meta">
                          <time datetime={entry.data.publishDate.toISOString()}>
                            {formatDate(entry.data.publishDate)}
                          </time>
                          {entry.data.tags.slice(0, 1).map((tag) => (
                            <span class="article-row__tag">{tag}</span>
                          ))}
                        </div>
                        <h2 class="text-balance font-semibold tracking-[-0.04em] text-black text-[1.75rem] lg:text-[2rem]">
                          {entry.data.title}
                        </h2>
                        <p class="text-black/58 mt-3 max-w-3xl leading-7 text-[0.98rem]">
                          {entry.data.description}
                        </p>
                      </div>
                      <span class="article-row__action">
                        <span>{page.ui.readArticleLabel}</span>
                        <Icon
                          name="mdi:arrow-right"
                          class="size-5 transition group-hover:translate-x-1"
                        />
                      </span>
                    </a>
                  ))}
                </div>
              ) : (
                <div class="article-empty">
                  <h2 class="font-semibold tracking-[-0.035em] text-black text-3xl">
                    {page.ui.emptyTitle}
                  </h2>
                  <p class="text-black/58 mt-4 max-w-xl leading-7">
                    {page.ui.emptyDescription}
                  </p>
                </div>
              )
            }
          </div>
        </section>
      </main>

      <footer class="border-black/6 border-t bg-[#f5f5f7]">
        <div
          class="text-black/52 mx-auto flex max-w-7xl flex-col gap-4 px-6 py-8 text-sm sm:flex-row sm:items-center sm:justify-between lg:px-8"
        >
          <p>{page.ui.footerNote}</p>
          <div class="flex items-center gap-4">
            <a href={page.homePath} class="transition hover:text-black">
              {page.ui.homeLabel}
            </a>
            <a
              href={appStoreUrl}
              target="_blank"
              rel="noreferrer"
              class="transition hover:text-black"
            >
              {page.ui.storeLabel}
            </a>
          </div>
        </div>
      </footer>
    </div>

    <PostHogAnalytics />
  </body>
</html>

<style is:global>
  html,
  body {
    font-family:
      "SF Pro Display",
      "SF Pro Text",
      "PingFang SC",
      -apple-system,
      BlinkMacSystemFont,
      "Helvetica Neue",
      sans-serif;
    background: #f5f5f7;
    color: #1d1d1f;
  }

  .section-label {
    color: rgba(29, 29, 31, 0.42);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .article-row {
    display: grid;
    gap: 1.25rem;
    align-items: start;
    border: 1px solid rgba(15, 23, 42, 0.07);
    border-radius: 1.35rem;
    background: rgba(255, 255, 255, 0.9);
    padding: 1.35rem 1.4rem;
    box-shadow: 0 16px 42px rgba(15, 23, 42, 0.06);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }

  .article-row:hover {
    transform: translateY(-2px);
    border-color: rgba(15, 23, 42, 0.14);
    box-shadow: 0 22px 56px rgba(15, 23, 42, 0.09);
  }

  @media (min-width: 768px) {
    .article-row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 1.5rem;
      padding: 1.5rem 1.6rem;
    }
  }

  .article-row__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    color: rgba(17, 24, 39, 0.44);
    font-size: 0.92rem;
  }

  .article-row__tag {
    border-radius: 999px;
    background: rgba(17, 24, 39, 0.06);
    padding: 0.18rem 0.55rem;
    color: rgba(17, 24, 39, 0.58);
    font-size: 0.86rem;
    font-weight: 600;
  }

  .article-row__content {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .article-row__action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: start;
    color: #111827;
    font-size: 0.94rem;
    font-weight: 650;
  }

  @media (min-width: 768px) {
    .article-row__action {
      justify-self: end;
      padding-top: 0.2rem;
      white-space: nowrap;
    }
  }

  .article-card {
    display: block;
    min-height: 18rem;
    border: 1px solid rgba(15, 23, 42, 0.07);
    border-radius: 1.6rem;
    background: rgba(255, 255, 255, 0.86);
    padding: 1.55rem;
    box-shadow: 0 18px 50px rgba(15, 23, 42, 0.07);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }

  .article-card:hover {
    transform: translateY(-3px);
    border-color: rgba(15, 23, 42, 0.14);
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.1);
  }

  .article-card__tag {
    border-radius: 999px;
    background: rgba(17, 24, 39, 0.06);
    padding: 0.18rem 0.55rem;
    color: rgba(17, 24, 39, 0.58);
  }

  .article-empty {
    border: 1px solid rgba(15, 23, 42, 0.07);
    border-radius: 1.6rem;
    background: rgba(255, 255, 255, 0.86);
    padding: 2rem;
  }

  .language-switcher {
    position: relative;
  }

  .language-switcher__summary {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    cursor: pointer;
    list-style: none;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.86);
    padding: 0.72rem 0.95rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: rgba(17, 24, 39, 0.8);
  }

  .language-switcher__summary::-webkit-details-marker {
    display: none;
  }

  .language-switcher__current {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.6rem;
    border-radius: 999px;
    background: rgba(17, 24, 39, 0.06);
    padding: 0.18rem 0.55rem;
  }

  .language-switcher__menu {
    position: absolute;
    right: 0;
    top: calc(100% + 0.55rem);
    min-width: 11.5rem;
    border-radius: 1.1rem;
    border: 1px solid rgba(15, 23, 42, 0.08);
    background: rgba(255, 255, 255, 0.96);
    padding: 0.4rem;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.12);
  }

  .language-switcher__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border-radius: 0.85rem;
    padding: 0.7rem 0.85rem;
    font-size: 0.9rem;
    color: rgba(17, 24, 39, 0.8);
  }

  .language-switcher__item:hover,
  .language-switcher__item--active {
    background: rgba(17, 24, 39, 0.06);
  }
</style>
