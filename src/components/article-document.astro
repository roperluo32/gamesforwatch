---
import { Icon } from "astro-icon/components";
import PostHogAnalytics from "~/components/posthog-analytics.astro";
import { appStoreUrl } from "~/data/landing";
import type { ArticleDetailPage } from "~/data/articles";
import { getArticlePath } from "~/data/articles";
import "~/styles/index.css";

interface Props {
  page: ArticleDetailPage;
}

const { page } = Astro.props as Props;
const { Content } = await page.entry.render();
const { generator, site } = Astro;
const pageUrl = new URL(page.path, site);
const image = new URL("social.jpg", site);
const posthogKey =
  import.meta.env.PUBLIC_POSTHOG_KEY ??
  "phc_hts9RHJKhHUgcr0iZTWbPjbVI1dkZq4TI9DvRY9wa6V";
const posthogHost =
  import.meta.env.PUBLIC_POSTHOG_HOST ?? "https://us.i.posthog.com";

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat(page.langAttr, {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(date);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: page.entry.data.title,
  description: page.entry.data.description,
  datePublished: page.entry.data.publishDate.toISOString(),
  dateModified:
    page.entry.data.updatedDate?.toISOString() ??
    page.entry.data.publishDate.toISOString(),
  url: pageUrl.href,
  inLanguage: page.langAttr,
  publisher: {
    "@type": "Organization",
    name: "Games for Watch",
    url: new URL(page.homePath, site).href,
  },
};
---

<!doctype html>
<html lang={page.langAttr} class="h-full motion-safe:scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/brand/app-logo.png" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/app-logo.png" />
    <meta name="generator" content={generator} />

    <title>{page.entry.data.title} | Games for Watch</title>
    <meta name="description" content={page.entry.data.description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={pageUrl.href} />
    {
      page.alternatePaths.map((item) => (
        <link
          rel="alternate"
          hreflang={item.hreflang}
          href={new URL(item.path, site).href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(page.defaultPath, site).href}
    />
    <meta name="apple-itunes-app" content="app-id=6752821820" />

    <meta property="og:title" content={page.entry.data.title} />
    <meta property="og:type" content="article" />
    <meta property="og:description" content={page.entry.data.description} />
    <meta property="og:image" content={image.href} />
    <meta property="og:url" content={pageUrl.href} />
    <meta property="og:site_name" content="Games for Watch" />
    <meta property="og:locale" content={page.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={page.entry.data.title} />
    <meta name="twitter:description" content={page.entry.data.description} />
    <meta name="twitter:image" content={image.href} />
    <meta name="twitter:url" content={pageUrl.href} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(articleSchema)}
    />
  </head>
  <body
    class="h-full overflow-x-hidden bg-[#f5f5f7] text-[#1d1d1f] text-base"
    data-locale={page.locale}
    data-posthog-key={posthogKey}
    data-posthog-host={posthogHost}
  >
    <div class="min-h-screen bg-[#f5f5f7]">
      <header
        class="border-black/6 sticky top-0 z-50 border-b bg-[rgba(245,245,247,0.76)] backdrop-blur-2xl"
      >
        <div
          class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-6 py-4 lg:px-8"
        >
          <a href={page.homePath} class="flex min-w-0 items-center gap-3">
            <img
              src="/brand/app-logo.png"
              alt="Games for Watch logo"
              class="border-black/8 size-10 rounded-[0.9rem] border bg-white object-cover shadow-[0_8px_24px_rgba(15,23,42,0.08)]"
            />
            <span class="hidden min-w-0 sm:block">
              <span class="block truncate font-semibold text-[0.98rem]"
                >Games for Watch</span
              >
              <span class="text-black/48 block truncate text-xs"
                >{page.ui.blogLabel}</span
              >
            </span>
          </a>

          <nav class="text-black/56 hidden items-center gap-7 text-sm lg:flex">
            <a href={page.homePath} class="transition hover:text-black"
              >{page.ui.homeLabel}</a
            >
            <a href={page.blogPath} class="transition hover:text-black"
              >{page.ui.blogLabel}</a
            >
          </nav>

          <div class="flex items-center gap-2.5">
            {
              page.languages.length > 1 && (
                <details class="language-switcher">
                  <summary class="language-switcher__summary">
                    <span>{page.ui.languageLabel}</span>
                    <span class="language-switcher__current">
                      {page.languages.find((item) => item.active)?.title ??
                        "EN"}
                    </span>
                    <Icon
                      name="mdi:chevron-down"
                      class="text-black/52 size-4"
                    />
                  </summary>
                  <div class="language-switcher__menu">
                    {page.languages.map((item) => (
                      <a
                        href={item.url}
                        class:list={[
                          "language-switcher__item",
                          item.active && "language-switcher__item--active",
                        ]}
                      >
                        <span>{item.title}</span>
                        {item.active && (
                          <Icon name="mdi:check" class="size-4 shrink-0" />
                        )}
                      </a>
                    ))}
                  </div>
                </details>
              )
            }
            <a
              href={appStoreUrl}
              target="_blank"
              rel="noreferrer"
              class="hover:bg-white/82 inline-flex rounded-full border border-black/10 bg-white px-4 py-2.5 font-semibold text-black transition text-sm hover:border-black/20"
            >
              {page.ui.storeLabel}
            </a>
          </div>
        </div>
      </header>

      <main>
        <article>
          <header class="border-black/6 border-b bg-white">
            <div class="mx-auto max-w-4xl px-6 py-16 lg:px-8 lg:py-20">
              <a
                href={page.blogPath}
                class="text-black/58 inline-flex items-center gap-2 font-semibold transition text-sm hover:text-black"
              >
                <Icon name="mdi:arrow-left" class="size-4" />
                {page.ui.backToBlogLabel}
              </a>
              <div
                class="text-black/44 mt-8 flex flex-wrap items-center gap-3 text-sm"
              >
                <time datetime={page.entry.data.publishDate.toISOString()}>
                  {formatDate(page.entry.data.publishDate)}
                </time>
                {
                  page.entry.data.updatedDate && (
                    <span>
                      {page.ui.updatedLabel}{" "}
                      {formatDate(page.entry.data.updatedDate)}
                    </span>
                  )
                }
              </div>
              <h1
                class="mt-5 text-balance font-semibold leading-[0.98] tracking-[-0.055em] text-[clamp(2.4rem,5vw,4.8rem)] text-black"
              >
                {page.entry.data.title}
              </h1>
              <p class="mt-6 max-w-3xl leading-8 text-black/60 text-lg">
                {page.entry.data.description}
              </p>
              <div class="mt-7 flex flex-wrap gap-2">
                {
                  page.entry.data.tags.map((tag) => (
                    <span class="article-tag">{tag}</span>
                  ))
                }
              </div>
            </div>
          </header>

          <div class="mx-auto max-w-3xl px-6 py-14 lg:px-8">
            <div class="article-prose">
              <Content />
            </div>
          </div>
        </article>

        {
          page.relatedArticles.length > 0 && (
            <section class="border-black/6 border-t bg-white">
              <div class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
                <p class="section-label">{page.ui.blogLabel}</p>
                <div class="mt-8 grid gap-5 md:grid-cols-3">
                  {page.relatedArticles.map((entry) => (
                    <a
                      href={getArticlePath(
                        entry.data.locale,
                        entry.data.articleSlug,
                      )}
                      class="article-card group"
                    >
                      <h2 class="text-balance font-semibold tracking-[-0.035em] text-black text-2xl">
                        {entry.data.title}
                      </h2>
                      <p class="text-black/58 mt-4 leading-7 text-sm">
                        {entry.data.description}
                      </p>
                      <span class="mt-7 inline-flex items-center gap-2 font-semibold text-black text-sm">
                        {page.ui.readArticleLabel}
                        <Icon
                          name="mdi:arrow-right"
                          class="size-4 transition group-hover:translate-x-1"
                        />
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            </section>
          )
        }
      </main>

      <footer class="border-black/6 border-t bg-[#f5f5f7]">
        <div
          class="text-black/52 mx-auto flex max-w-7xl flex-col gap-4 px-6 py-8 text-sm sm:flex-row sm:items-center sm:justify-between lg:px-8"
        >
          <p>{page.ui.footerNote}</p>
          <div class="flex items-center gap-4">
            <a href={page.homePath} class="transition hover:text-black">
              {page.ui.homeLabel}
            </a>
            <a href={page.blogPath} class="transition hover:text-black">
              {page.ui.blogLabel}
            </a>
          </div>
        </div>
      </footer>
    </div>

    <PostHogAnalytics />
  </body>
</html>

<style is:global>
  html,
  body {
    font-family:
      "SF Pro Display",
      "SF Pro Text",
      "PingFang SC",
      -apple-system,
      BlinkMacSystemFont,
      "Helvetica Neue",
      sans-serif;
    background: #f5f5f7;
    color: #1d1d1f;
  }

  .section-label {
    color: rgba(29, 29, 31, 0.42);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .article-tag {
    border-radius: 999px;
    background: rgba(17, 24, 39, 0.06);
    padding: 0.42rem 0.72rem;
    color: rgba(17, 24, 39, 0.62);
    font-size: 0.86rem;
    font-weight: 600;
  }

  .article-card {
    display: block;
    border: 1px solid rgba(15, 23, 42, 0.07);
    border-radius: 1.6rem;
    background: rgba(255, 255, 255, 0.86);
    padding: 1.55rem;
    box-shadow: 0 18px 50px rgba(15, 23, 42, 0.07);
    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      border-color 180ms ease;
  }

  .article-card:hover {
    transform: translateY(-3px);
    border-color: rgba(15, 23, 42, 0.14);
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.1);
  }

  .article-prose {
    color: rgba(29, 29, 31, 0.78);
    font-size: 1.06rem;
    line-height: 1.88;
  }

  .article-prose > * + * {
    margin-top: 1.2rem;
  }

  .article-prose h2 {
    margin-top: 2.6rem;
    color: #1d1d1f;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1.08;
  }

  .article-prose h3 {
    margin-top: 2rem;
    color: #1d1d1f;
    font-size: 1.35rem;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .article-prose p,
  .article-prose li {
    color: rgba(29, 29, 31, 0.72);
  }

  .article-prose ul,
  .article-prose ol {
    padding-left: 1.35rem;
  }

  .article-prose li + li {
    margin-top: 0.45rem;
  }

  .article-prose a {
    color: #111827;
    font-weight: 650;
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .language-switcher {
    position: relative;
  }

  .language-switcher__summary {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    cursor: pointer;
    list-style: none;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.86);
    padding: 0.72rem 0.95rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: rgba(17, 24, 39, 0.8);
  }

  .language-switcher__summary::-webkit-details-marker {
    display: none;
  }

  .language-switcher__current {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.6rem;
    border-radius: 999px;
    background: rgba(17, 24, 39, 0.06);
    padding: 0.18rem 0.55rem;
  }

  .language-switcher__menu {
    position: absolute;
    right: 0;
    top: calc(100% + 0.55rem);
    min-width: 11.5rem;
    border-radius: 1.1rem;
    border: 1px solid rgba(15, 23, 42, 0.08);
    background: rgba(255, 255, 255, 0.96);
    padding: 0.4rem;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.12);
  }

  .language-switcher__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border-radius: 0.85rem;
    padding: 0.7rem 0.85rem;
    font-size: 0.9rem;
    color: rgba(17, 24, 39, 0.8);
  }

  .language-switcher__item:hover,
  .language-switcher__item--active {
    background: rgba(17, 24, 39, 0.06);
  }
</style>
