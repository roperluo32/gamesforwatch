---
import { Icon } from "astro-icon/components";
import { GAMEHUB_APP_STORE_URL } from "~/lib/catalog";
import type { GamesUi } from "~/data/games";
import { gamesUiByLocale } from "~/data/games";

interface LanguageOption {
  title: string;
  url: string;
  locale: string;
  active?: boolean;
}

interface Props {
  title?: string;
  currentPath?: string;
  homePath?: string;
  gamesPath?: string;
  appsPath?: string;
  updatedPath?: string;
  freePath?: string;
  blogPath?: string;
  ui?: GamesUi;
  languages?: LanguageOption[];
  showLanguageSwitcher?: boolean;
}

const {
  title = "Games for Watch",
  currentPath = "",
  homePath = "/",
  gamesPath = "/games/",
  appsPath = "/apps/",
  updatedPath = "/apps/updated/",
  freePath = "/apps/free/",
  blogPath = "/articles/",
  ui = gamesUiByLocale.en,
  languages = [],
  showLanguageSwitcher = false,
} = Astro.props as Props;
const path = currentPath || Astro.url.pathname;
---

<header
  class="border-black/6 sticky top-0 z-50 border-b bg-[rgba(245,245,247,0.72)] backdrop-blur-2xl"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-4 lg:px-8">
    <a href={homePath} class="flex items-center gap-3 tracking-tight text-black text-sm">
      <img
        src="/brand/app-logo.png"
        alt="Games for Watch logo"
        class="border-black/8 size-10 rounded-[0.9rem] border bg-white object-cover shadow-[0_8px_24px_rgba(15,23,42,0.08)]"
        loading="eager"
        decoding="async"
      />
      <span class="hidden sm:block">
        <span class="block font-semibold text-[0.98rem]">{title}</span>
        <span class="text-black/48 block text-xs">{ui.brandTagline}</span>
      </span>
    </a>

    <nav class="text-black/56 hidden items-center gap-6 text-sm lg:flex">
      <a
        href={gamesPath}
        class:list={["transition hover:text-black", path.includes("/games") && "font-semibold text-black"]}
      >
        {ui.gamesNav}
      </a>
      <a
        href={appsPath}
        class:list={[
          "transition hover:text-black",
          path.includes("/apps") && !path.includes("/updated") && !path.includes("/free") && "font-semibold text-black",
        ]}
      >
        {ui.appsNav}
      </a>
      <a
        href={updatedPath}
        class:list={["transition hover:text-black", path.includes("/updated") && "font-semibold text-black"]}
      >
        {ui.updatedNav}
      </a>
      <a
        href={freePath}
        class:list={["transition hover:text-black", path.includes("/free") && "font-semibold text-black"]}
      >
        {ui.freeNav}
      </a>
      <a href={blogPath} class="transition hover:text-black">{ui.blogNav}</a>
    </nav>

    <div class="flex items-center gap-2.5">
      {
        showLanguageSwitcher && languages.length > 0 ? (
          <details class="language-switcher">
            <summary class="language-switcher__summary">
              <span>{ui.languageLabel}</span>
              <span class="language-switcher__current">
                {languages.find((item) => item.active)?.title ?? "EN"}
              </span>
              <Icon name="mdi:chevron-down" class="text-black/52 size-4" />
            </summary>
            <div class="language-switcher__menu">
              {languages.map((item) => (
                <a
                  href={item.url}
                  class:list={[
                    "language-switcher__item",
                    item.active && "language-switcher__item--active",
                  ]}
                  data-locale-target={item.locale}
                >
                  <span>{item.title}</span>
                  {item.active && (
                    <Icon name="mdi:check" class="size-4 shrink-0" />
                  )}
                </a>
              ))}
            </div>
          </details>
        ) : null
      }
      <a
        href={GAMEHUB_APP_STORE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex rounded-full border border-black/10 bg-white px-4 py-2.5 font-semibold text-black transition text-sm hover:border-black/20 hover:bg-white/80"
      >
        {ui.downloadNav}
      </a>
    </div>
  </div>
</header>
