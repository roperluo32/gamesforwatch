---
import CatalogShell from "~/components/catalog/catalog-shell.astro";
import type { CatalogIndexEntry } from "~/lib/catalog";

interface Props {
  title: string;
  description: string;
  path: string;
  heading: string;
  lead: string;
  apps: CatalogIndexEntry[];
}

const { title, description, path, heading, lead, apps } = Astro.props as Props;

function previewImagesFor(app: CatalogIndexEntry): string[] {
  const fromIndex = (app as CatalogIndexEntry & { previewImages?: string[] }).previewImages;
  if (Array.isArray(fromIndex) && fromIndex.length) return fromIndex;
  return app.artworkUrl512 ? [app.artworkUrl512] : [];
}
---

<CatalogShell title={title} description={description} path={path}>
  <section class="mx-auto max-w-7xl px-6 py-12 lg:px-8">
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{heading}</h1>
    <p class="text-black/60 mt-4 max-w-2xl text-lg">{lead}</p>
    <p class="text-black/40 mt-2 text-sm">{apps.length} apps</p>

    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        apps.map((app) => {
          const images = previewImagesFor(app);
          return (
            <li>
              <a
                href={app.path}
                class="border-black/8 group block overflow-hidden rounded-2xl border bg-white shadow-[0_8px_24px_rgba(15,23,42,0.04)] transition hover:border-black/15 hover:shadow-[0_16px_40px_rgba(15,23,42,0.08)]"
              >
                <div
                  class="app-card-media relative aspect-[3/4] overflow-hidden bg-[#ececef]"
                  data-images={JSON.stringify(images)}
                  data-track-id={app.trackId}
                >
                  {images.map((src, i) => (
                    <img
                      src={src}
                      alt=""
                      class:list={[
                        "absolute inset-0 h-full w-full object-cover transition-opacity duration-700",
                        i === 0 ? "opacity-100" : "opacity-0",
                      ]}
                      loading={i === 0 ? "lazy" : "lazy"}
                      data-rotate-index={i}
                    />
                  ))}
                </div>
                <div class="flex items-start gap-3 p-4">
                  <img
                    src={app.artworkUrl512}
                    alt=""
                    class="border-black/8 h-12 w-12 shrink-0 rounded-[12px] border object-cover"
                    width="48"
                    height="48"
                    loading="lazy"
                  />
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="truncate font-semibold text-black">{app.trackName}</span>
                      {app.isOwnApp ? (
                        <span class="rounded-full bg-black px-2 py-0.5 text-[10px] font-medium text-white">
                          Our app
                        </span>
                      ) : null}
                    </div>
                    <div class="text-black/50 mt-1 text-sm">
                      ★ {(app.averageUserRating || 0).toFixed(1)} ·{" "}
                      {app.formattedPrice || (app.price === 0 ? "Free" : "")}
                    </div>
                  </div>
                </div>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>
</CatalogShell>

<script is:inline src="/scripts/app-card-rotate.js"></script>
