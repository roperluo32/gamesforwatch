---
import CatalogShell from "~/components/catalog/catalog-shell.astro";
import { getCatalogIndex, type CatalogIndexEntry } from "~/lib/catalog";

interface Props {
  title: string;
  description: string;
  path: string;
  heading: string;
  lead: string;
  apps: CatalogIndexEntry[];
}

const { title, description, path, heading, lead, apps } = Astro.props as Props;
---

<CatalogShell title={title} description={description} path={path}>
  <section class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{heading}</h1>
    <p class="mt-4 max-w-2xl text-lg text-white/70">{lead}</p>
    <p class="mt-2 text-sm text-white/40">{apps.length} apps</p>

    <ul class="mt-10 divide-y divide-white/10 overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03]">
      {
        apps.map((app) => (
          <li>
            <a href={app.path} class="flex items-center gap-4 px-4 py-4 transition hover:bg-white/[0.05]">
              <img
                src={app.artworkUrl512}
                alt=""
                class="h-14 w-14 rounded-[14px] border border-white/10 object-cover"
                width="56"
                height="56"
                loading="lazy"
              />
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="truncate font-medium text-white">{app.trackName}</span>
                  {app.isOwnApp ? (
                    <span class="rounded-full bg-pink-500/20 px-2 py-0.5 text-[10px] text-pink-200">Our app</span>
                  ) : null}
                  {app.hasWatch ? (
                    <span class="rounded-full bg-sky-500/15 px-2 py-0.5 text-[10px] text-sky-200">Watch</span>
                  ) : null}
                </div>
                <div class="mt-1 text-sm text-white/50">
                  ★ {(app.averageUserRating || 0).toFixed(1)} · {app.formattedPrice || (app.price === 0 ? "Free" : "")} · v
                  {app.version}
                </div>
              </div>
              <span class="hidden text-sm text-white/35 sm:inline">Get →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</CatalogShell>
