---
import CatalogHeader from "~/components/catalog/catalog-header.astro";
import PostHogAnalytics from "~/components/posthog-analytics.astro";
import { GAMEHUB_APP_STORE_URL } from "~/lib/catalog";
import "~/styles/index.css";

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
}

const { title, description, path, ogImage } = Astro.props as Props;
const { generator, site } = Astro;
const pageUrl = new URL(path, site);
const image = new URL(ogImage || "social.jpg", site);
const posthogKey =
  import.meta.env.PUBLIC_POSTHOG_KEY ??
  "phc_hts9RHJKhHUgcr0iZTWbPjbVI1dkZq4TI9DvRY9wa6V";
const posthogHost =
  import.meta.env.PUBLIC_POSTHOG_HOST ?? "https://us.i.posthog.com";
---

<!doctype html>
<html lang="en" class="h-full motion-safe:scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/brand/app-logo.png" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/app-logo.png" />
    <meta name="generator" content={generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={pageUrl.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl.href} />
    <meta property="og:image" content={image.href} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="apple-itunes-app" content="app-id=6752821820" />
  </head>
  <body class="min-h-full bg-[#f5f5f7] text-[#1d1d1f] antialiased">
    <CatalogHeader currentPath={path} />
    <main>
      <slot />
    </main>
    <footer class="border-black/6 border-t bg-[#f5f5f7]">
      <div
        class="text-black/52 mx-auto flex max-w-7xl flex-col gap-4 px-6 py-8 text-sm sm:flex-row sm:items-center sm:justify-between lg:px-8"
      >
        <p>Games for Watch · Discover Apple Watch games</p>
        <div class="flex flex-wrap items-center gap-4">
          <a href="/games/" class="transition hover:text-black">Our Games</a>
          <a href="/apps/" class="transition hover:text-black">Watch Apps</a>
          <a
            href={GAMEHUB_APP_STORE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="transition hover:text-black"
          >
            App Store
          </a>
          <a href="mailto:monkey20001@126.com" class="transition hover:text-black">Contact</a>
        </div>
      </div>
    </footer>
    <PostHogAnalytics apiKey={posthogKey} apiHost={posthogHost} />
  </body>
</html>
