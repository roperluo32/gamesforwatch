    },
    {
      "version": "3.0.0",
      "releaseNotes": "- New version of the game (Version 2) with more realistic physics engine\n- Fixed bugs from the original game (Version 1)",
      "seenAt": "2022-05-26T13:22:59Z"
    },
    {
      "version": "3.2.0",
      "releaseNotes": "Now you can compete against the machine!",
