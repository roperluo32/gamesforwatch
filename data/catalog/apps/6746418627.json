  "versionHistory": [
    {
      "version": "1.0",
      "releaseNotes": "This app has been updated by Apple to prepare for watchOS 27 compatibility. No new features are included.",
      "seenAt": "2025-06-14T08:37:51Z"
    },
    {
      "version": "1.1",
      "releaseNotes": "New: ghost piece preview shows exactly where your piece will land.\nToggle it on or off right from the start screen - it remembers your choice.\nRebuilt with the latest iOS/watchOS SDK for the newest Apple Watch and iPhone.",
      "seenAt": "2026-09-15T23:24:12Z"
    },
    {
      "version": "1.2",
      "releaseNotes": "New: Daily Challenge. Everyone gets the same falling-block puzzle once a day — build a streak, chase your best score, and check your progress right on the start screen or by asking Siri, no need to open the app.\n\nReal Game Center support: sign in (optional) to submit scores to a live leaderboard and unlock streak achievements. Still fully playable offline.\n\nRefreshed look: a new hand-drawn accent style throughout, an ambient status orb, and a richer results screen with a 7-day trend chart.\n\nRebuilt on the latest watchOS SDK for reliability on the newest hardware.",
      "seenAt": "2026-09-28T11:32:02Z"
    },
    {
      "version": "1.3",
      "releaseNotes": "Now available in Spanish.\nImproved for UK, Australian and Canadian users.\nSmall fixes and polish.",
      "seenAt": "2026-09-30T10:48:58Z"
    },
    {
      "version": "1.3.1",
      "releaseNotes": "New name: Stack: Block Puzzle for Watch.\nRefreshed App Store screenshots and description.\nBuilt with Xcode 27.1.",
      "seenAt": "2026-10-14T20:23:41Z"
    },
    {
      "version": "2.0",
      "releaseNotes": "Stack is now a game for iPhone and iPad too.\nNew: touch controls, a Daily Challenge tile shared with your watch, and stepped haptics on line clears.\nBuilt with the latest iOS and watchOS SDK.",
      "seenAt": "2026-10-15T19:06:29Z"
    },
    {
      "version": "2.1",
      "releaseNotes": "Now free to download. Endless runs on iPhone, iPad and Apple Watch stay free, with the tutorial, Game Center and your recent runs. A one-time Pro unlock adds the Daily Challenge, the same pieces for every player each day, with its streak and history. If you bought Stack before it went free, everything stays unlocked and there is nothing to do.",
      "seenAt": "2026-10-17T12:22:56Z"
    }
  ],
  "updatedAt": "2026-10-22T12:14:09.900Z",
