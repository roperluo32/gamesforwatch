    },
    {
      "version": "2021.2",
      "releaseNotes": "Name changed to Digital Dog!\n\n\r\n\r\nMinor tweaks and improvements.",
      "seenAt": "2021-06-11T15:50:27Z"
    },
    {
      "version": "2021.3",
      "releaseNotes": "- Upgraded the onboarding to point out how to open the menu\n- Made it more obvious when your puppy is hungry\n\nNOTE: Existing users, you may see the swiping hint arrow again, but it only shows once!\n\n- Johnno and Pete",
      "seenAt": "2021-06-21T16:31:39Z"
    },
    {
      "version": "2021.4",
      "releaseNotes": "- Added hint text to items to better explain how to change bowls and mats\n\nCheers,\nJohnno and Pete",
      "seenAt": "2021-07-09T18:13:22Z"
    },
    {
      "version": "2021.5",
      "releaseNotes": "NOW FREE! We've gone free to allow more people to enjoy having a puppy on their phone and Watch!\nNOW FREE! We've gone free to allow more people to enjoy having a puppy on their phone and Watch!\n\n- Introducing balls! 8 different balls to unlock\n- Updated hints. Added some more hints to explain swiping to see bowls\n- Unlock bowls, mats, balls and treats any time by watching ads on iPhone\n- Apple Watch is the same as the paid version, and stuff unlocks daily\n\nEnjoy,\nJohnno and Pete\n",
      "seenAt": "2021-07-14T03:03:17Z"
    },
    {
      "version": "2021.6",
      "releaseNotes": "NOW FREE! We've gone free to allow more people to enjoy having a puppy on their phone and Watch!\n\n- Introducing balls! 8 different balls to unlock\n- Added tab buttons on Item selector screen take you to the bowls, mats and balls sections faster\n- Updated hints. Added some more hints to explain swiping to see bowls\n- Unlock bowls, mats, balls and treats any time by watching ads on iPhone\n- Apple Watch is the same as the paid version, and stuff unlocks daily\n\nEnjoy,\nJohnno and Pete\n",
      "seenAt": "2021-07-17T12:27:36Z"
    },
