    {
      "version": "1.4.0",
      "releaseNotes": "Apple Watch Support Added!\nEnjoy the classic Tic-Tac-Toe game right on your Apple Watch. Simple, fun gameplay now available on your wrist. Perfect for quick breaks and mental relaxation anytime, anywhere!",
      "seenAt": "2024-09-24T13:21:30Z"
    },
    {
      "version": "1.5.0",
      "releaseNotes": "Dark Mode Support. We’ve added Dark Mode to make the app easier on the eyes, especially in low-light environments. Enjoy a more comfortable experience, day or night.",
      "seenAt": "2024-09-25T16:25:29Z"
    },
    {
      "version": "1.6.0",
      "releaseNotes": "Minor bug fixes.",
