    },
    {
      "version": "1.7.0",
      "releaseNotes": "We've added new widgets for iPhone and Apple Watch, making it easier and faster to access the app right from your home screen.",
      "seenAt": "2024-09-30T22:43:39Z"
    },
    {
      "version": "1.8.0",
      "releaseNotes": "Thank you for always using the Tic-Tac-Toe app. In this update, we have added the following features.\n\nYou can now switch between dark mode and light mode on the widget. Enjoy playing in your preferred display mode.\n\nYou can freely change the color scheme on the widget. Let's enjoy the game with your own unique theme.\n\nPlease update to the latest version to try out the new features. We appreciate your continued support of the Tic-Tac-Toe app.",
      "seenAt": "2024-10-06T09:59:39Z"
    },
    {
      "version": "1.9.0",
      "releaseNotes": "Minor bug fixes.",
      "seenAt": "2024-10-13T11:28:22Z"
    },
    {
      "version": "1.9.2",
      "releaseNotes": "The app now respects the iOS “Reduce Motion” accessibility setting. When enabled, animations are replaced with more subtle transitions for a more comfortable and accessible gameplay experience.",
